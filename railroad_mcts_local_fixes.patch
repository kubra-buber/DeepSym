From fc4cd2f615665e35895b7a6889fc32e8efbacb36 Mon Sep 17 00:00:00 2001
From: kubra-buber <kubrabuberrrr@gmail.com>
Date: Fri, 24 Jul 2026 16:24:59 +0300
Subject: [PATCH] Apply DeepSym MCTS correctness and root statistics patches

---
 .../railroad/include/railroad/constants.hpp   |  2 +-
 .../railroad/include/railroad/planner.hpp     | 63 ++++++++++++++++---
 2 files changed, 57 insertions(+), 8 deletions(-)

diff --git a/packages/railroad/include/railroad/constants.hpp b/packages/railroad/include/railroad/constants.hpp
index 7684ddc..209e2f0 100644
--- a/packages/railroad/include/railroad/constants.hpp
+++ b/packages/railroad/include/railroad/constants.hpp
@@ -2,7 +2,7 @@
 
 namespace railroad {
 
-const double HEURISTIC_CANNOT_FIND_GOAL_PENALTY = 0.0;
+const double HEURISTIC_CANNOT_FIND_GOAL_PENALTY = 100.0;
 const double HEURISTIC_MULTIPLIER = 5;
 const double SUCCESS_REWARD = 0.0;
 const double ALL_ROBOTS_WAITING_PENALTY = 10.0;
diff --git a/packages/railroad/include/railroad/planner.hpp b/packages/railroad/include/railroad/planner.hpp
index 0ffaf1f..dc23bc8 100644
--- a/packages/railroad/include/railroad/planner.hpp
+++ b/packages/railroad/include/railroad/planner.hpp
@@ -324,7 +324,7 @@ inline std::string mcts(const State &root_state,
   // RNG
   static thread_local std::mt19937 rng{std::random_device{}()};
 
-  auto all_actions = get_usable_actions(root_state, all_actions_base);
+  const auto &all_actions = all_actions_base;
 
   // Root node
   auto root = std::make_unique<MCTSDecisionNode>(root_state.copy_and_zero_out_time());
@@ -351,15 +351,13 @@ inline std::string mcts(const State &root_state,
 
     // ---------------- Selection ----------------
     while (depth < max_depth) {
-      if (!node->untried_actions.empty())
-        break;
-      if (node->children.empty())
-        break;
-      // Use GoalBase::evaluate for goal check
+      // Goal states are terminal even when more actions are applicable.
       if (goal->evaluate(node->state.fluents())) {
         is_node_goal = true;
         break;
       }
+      if (!node->untried_actions.empty()) break;
+      if (node->children.empty()) break;
 
       MCTSChanceNode *best_chance = nullptr;
       double best_score = -std::numeric_limits<double>::infinity();
@@ -383,7 +381,9 @@ inline std::string mcts(const State &root_state,
     }
 
     // ---------------- Expansion ----------------
-    if (!node->untried_actions.empty() && !is_node_goal) {
+    if (depth < max_depth &&
+        !node->untried_actions.empty() &&
+        !is_node_goal) {
       const Action *action = node->untried_actions.back();
       node->untried_actions.pop_back();
 
@@ -441,6 +441,55 @@ inline std::string mcts(const State &root_state,
 
   // Generate tree trace
   std::ostringstream tree_trace_stream;
+
+  // ROOT ACTION STATISTICS
+  // These values expose what MCTS actually estimated at the root.
+  // `value` is the accumulated surrogate reward, not reachability probability.
+  tree_trace_stream << std::fixed << std::setprecision(6);
+  tree_trace_stream << "ROOT_STATS"
+                    << "\troot_visits=" << root->visits
+                    << "\tc=" << c
+                    << "\theuristic_multiplier=" << heuristic_multiplier
+                    << "\n";
+
+  for (const auto &kv : root->children) {
+    const MCTSChanceNode *chance = kv.second.get();
+    const double mean_q =
+        chance->visits > 0
+            ? chance->value / static_cast<double>(chance->visits)
+            : 0.0;
+    const double final_ucb =
+        ucb_score(root->visits, *chance, c);
+
+    tree_trace_stream << "ROOT_ACTION"
+                      << "\tname=" << chance->action->name()
+                      << "\tvisits=" << chance->visits
+                      << "\ttotal_reward=" << chance->value
+                      << "\tmean_q=" << mean_q
+                      << "\tucb=" << final_ucb
+                      << "\n";
+
+    const std::size_t outcome_count =
+        std::min(chance->children.size(), chance->outcome_weights.size());
+    for (std::size_t i = 0; i < outcome_count; ++i) {
+      const MCTSDecisionNode *outcome = chance->children[i].get();
+      const double outcome_mean_q =
+          outcome->visits > 0
+              ? outcome->value / static_cast<double>(outcome->visits)
+              : 0.0;
+
+      tree_trace_stream << "ROOT_OUTCOME"
+                        << "\taction=" << chance->action->name()
+                        << "\tindex=" << i
+                        << "\tprobability=" << chance->outcome_weights[i]
+                        << "\tvisits=" << outcome->visits
+                        << "\ttotal_reward=" << outcome->value
+                        << "\tmean_q=" << outcome_mean_q
+                        << "\n";
+    }
+  }
+
+  tree_trace_stream << "BEST_PATH\n";
   tree_trace_stream << std::fixed << std::setprecision(2);
   print_best_path(tree_trace_stream, root.get(), heuristic_fn, 20);
 
-- 
